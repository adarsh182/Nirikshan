{
  "expo": {
    "name": "Field Test Companion",
    "slug": "fieldtest-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fieldtest",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture field drug test results",
        "NSLocationWhenInUseUsageDescription": "Record GPS location of field tests"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Field Test Companion to capture test result images."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Field Test Companion to record test location."
        }
      ],
      "expo-asset"
    ]
  }
}
