{
  "expo": {
    "name": "Nirikshan",
    "slug": "nirikshan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nirikshan",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture field drug test results for forensic screening",
        "NSLocationWhenInUseUsageDescription": "Record GPS location of presumptive field tests"
      }
    },
    "android": {
      "package": "com.nirikshan.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nirikshan to capture test result images."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Nirikshan to record test coordinates."
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
